NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/adhayan
TRUST_PROXY=0
# Generate independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Same-site frontend/API deployment is required for these Strict cookies.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_EMAIL=
# Optional: Gemini API is invoked only from the server.
GEMINI_API_KEY=
GEMINI_MODEL=
TURN_URL=
TURN_SHARED_SECRET=

# Encrypted export: pause application writes first. Restore only to an empty isolated database.
BACKUP_KEY=
BACKUP_WRITES_PAUSED=false
RESTORE_DATABASE=adhayan_restore_review
